# примеры API-запросов

@baseUrl = http://localhost:8000/api
Admin - 66060cb1a07577491b0d6f4acfeec454791be47d
Admin2 - 3753bc16ee92f119ca1898e2410d93b0c7827ea8
user1 - d256c47182fd527c2727a70dd8742d88221d2b1f
user2 - 1b59a4a44b6339c71e10d8ade4f7a6bd398eafc5

###
# получение объявлений
GET {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token 1b59a4a44b6339c71e10d8ade4f7a6bd398eafc5

###
# получение объявлений
GET {{baseUrl}}/advertisements/54
Content-Type: application/json
Authorization: Token 1b59a4a44b6339c71e10d8ade4f7a6bd398eafc5

###

# создание объявления
POST {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token 1b59a4a44b6339c71e10d8ade4f7a6bd398eafc5

{
  "title": "Шкаф IKEA",
  "description": "Срочно",
  "status": "DRAFT"
}

###

# попытка поменять объявление
PATCH {{baseUrl}}/advertisements/54/
Content-Type: application/json
Authorization: Token d256c47182fd527c2727a70dd8742d88221d2b1f

{
  "title": "Шкаф IKEA 4",
  "status": "OPEN"
}

###

# фильтрация по создателю
GET {{baseUrl}}/advertisements/?creator=4
Content-Type: application/json

###

# фильтрация по дате
GET {{baseUrl}}/advertisements/?created_at_before=2026-11-16
Content-Type: application/json

###

# фильтрация по дате
GET {{baseUrl}}/advertisements/?created_at_after=2026-11-16
Content-Type: application/json

###

# фильтрация по статусу
GET {{baseUrl}}/advertisements/?status=OPEN
Content-Type: application/json


###

# попытка удалить объявление
DELETE {{baseUrl}}/advertisements/53/
Content-Type: application/json
Authorization: Token 66060cb1a07577491b0d6f4acfeec454791be47d